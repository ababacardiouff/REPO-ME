generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EatsMenuCategory {
  id        String   @id @default(uuid())
  vendorId  String
  code      String?  @unique
  name      Json
  parentId  String?
  position  Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  items     EatsMenuItem[]

  @@map("eats_menu_categories")
}

model EatsMenuItem {
  id                 String   @id @default(uuid())
  vendorId           String
  categoryId         String?
  skuCode            String   @unique
  name               Json
  description        Json?
  defaultPriceCents  BigInt
  currency           String
  availability       Json?    @default("{}")
  images             Json?    @default("[]")
  status             String   @default("draft")
  fatimaQualityScore Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  category           EatsMenuCategory? @relation(fields: [categoryId], references: [id])
  skus               EatsMenuSku[]
  modifiers          EatsItemModifierMapping[]
  allergens          EatsItemAllergen[]

  @@map("eats_menu_items")
}

model EatsMenuSku {
  id         String   @id @default(uuid())
  itemId     String
  skuCode    String   @unique
  priceCents BigInt
  stock      Int      @default(0)
  attributes Json?    @default("{}")
  createdAt  DateTime @default(now())
  item       EatsMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("eats_menu_skus")
}

model EatsModifierGroup {
  id        String   @id @default(uuid())
  vendorId  String
  name      Json
  rules     Json
  position  Int      @default(0)
  createdAt DateTime @default(now())
  items     EatsModifierItem[]
  mappings  EatsItemModifierMapping[]

  @@map("eats_modifier_groups")
}

model EatsModifierItem {
  id              String @id @default(uuid())
  groupId         String
  skuId           String?
  name            Json
  priceDeltaCents BigInt @default(0)
  position        Int    @default(0)
  group           EatsModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("eats_modifier_items")
}

model EatsItemModifierMapping {
  id              String @id @default(uuid())
  itemId          String
  modifierGroupId String
  item            EatsMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifierGroup   EatsModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@map("eats_item_modifier_mapping")
}

model EatsAllergen {
  id    String @id @default(uuid())
  code  String @unique
  name  Json
  items EatsItemAllergen[]

  @@map("eats_allergens")
}

model EatsItemAllergen {
  itemId     String
  allergenId String
  item       EatsMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  allergen   EatsAllergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([itemId, allergenId])
  @@map("eats_item_allergens")
}


model EatsProduct {
  id           String   @id @default(uuid())
  vendorId     String   @map("vendor_id")
  skuCode      String   @unique @map("sku_code")
  name         Json
  description  Json?
  images       Json?    @default("[]")
  categoryId   String?  @map("category_id")
  priceCents   BigInt   @map("price_cents")
  currency     String
  country      String?
  stock        Int      @default(0)
  isAvailable  Boolean  @default(true) @map("is_available")
  fatimaScore  Int      @default(100) @map("Fatima_score")
  avgRating    Float    @default(0) @map("avg_rating")
  totalReviews Int      @default(0) @map("total_reviews")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  variants     EatsProductVariant[]
  events       EatsProductEvent[]

  @@map("eats_products")
}

model EatsProductVariant {
  id          String      @id @default(uuid())
  productId   String      @map("product_id")
  variantCode String      @unique @map("variant_code")
  attributes  Json?       @default("{}")
  priceCents  BigInt?     @map("price_cents")
  stock       Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  product     EatsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("eats_product_variants")
}

model EatsProductEvent {
  id        BigInt     @id @default(autoincrement())
  productId String     @map("product_id")
  eventType String     @map("event_type")
  meta      Json?      @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")
  product   EatsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("eats_product_events")
}

model EatsOrderSnapshot {
  id              String   @id @default(uuid())
  vendorId        String?  @map("vendor_id")
  productId       String?  @map("product_id")
  skuId           String?  @map("sku_id")
  buyerId         String?  @map("buyer_id")
  orderAmountCents BigInt? @map("order_amount_cents")
  currency        String?
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("eats_orders_snapshot")
}

model EatsOutbox {
  id            BigInt   @id @default(autoincrement())
  aggregateType String?
  aggregateId   String?
  eventType     String?
  payload       Json?
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("eats_outbox")
}

model EatsOrders {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  totalAmount    Decimal          @map("total_amount")
  discountAmount Decimal          @default(0) @map("discount_amount")
  finalAmount    Decimal          @map("final_amount")
  promoCode      String?          @map("promo_code")
  status         String           @default("PENDING")
  abandonedFrom  String?          @map("abandoned_from")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          EatsOrderItems[]

  @@map("eats_orders")
}

model EatsOrderItems {
  id        String     @id @default(uuid())
  orderId   String     @map("order_id")
  productId String     @map("product_id")
  quantity  Int
  unitPrice Decimal    @map("unit_price")
  subtotal  Decimal
  order     EatsOrders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("eats_order_items")
}

model EatsPromoCodes {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  discount    Int
  maxUsage    Int      @map("max_usage")
  usedCount   Int      @default(0) @map("used_count")
  validFrom   DateTime @map("valid_from")
  validTo     DateTime @map("valid_to")
  active      Boolean  @default(true)
  fatimaScore Float    @default(0) @map("Fatima_score")

  @@map("eats_promo_codes")
}

model EatsAbandonedCarts {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  itemsJson   Json     @map("items_json")
  restored    Boolean  @default(false)
  probability Float    @default(0)
  notified    Boolean  @default(false)
  variant     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("eats_abandoned_carts")
}

model EatsABConfig {
  id         String   @id @default(uuid())
  forcedMode String   @default("random")
  updatedAt  DateTime @updatedAt

  @@map("eats_ab_config")
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  molamId   String
  amount    Float
  currency  String
  reason    String
  language  String   @default("fr")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id])

  @@map("eats_refunds")
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  total     Float
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds   Refund[]

  @@map("eats_orders_refund")
}

model Event {
  id        String   @id @default(uuid())
  type      String
  payload   String
  createdAt DateTime @default(now())

  @@map("eats_refund_events")
}

model EatsUser {
  id             String   @id @default(uuid())
  molamId        String   @unique @map("molam_id")
  country        String
  currency       String
  language       String
  displayName    String?  @map("display_name")
  email          String?
  phone          String?
  docContainerId String?  @map("doc_container_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  addresses EatsUserAddress[]
  history   EatsUserHistory[]
  sessions  EatsUserSession[]

  @@map("eats_users")
}

model EatsUserAddress {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String?
  line1      String?
  line2      String?
  city       String?
  postalCode String?  @map("postal_code")
  country    String?
  lat        Float?
  lon        Float?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  user EatsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("eats_user_addresses")
}

model EatsUserHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kind      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  user EatsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("eats_user_history")
}

model EatsUserSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceInfo Json?    @map("device_info")
  lastSeen   DateTime @default(now()) @map("last_seen")

  user EatsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("eats_user_sessions")
}

model EatsRestaurant {
  id          String    @id @default(uuid())
  vendorId    String?   @map("vendor_id")
  molamId     String    @map("molam_id")
  name        Json
  slug        String    @unique
  description Json?
  logoUrl     String?   @map("logo_url")
  country     String?
  currency    String?
  language    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  categories EatsCatalogCategory[]
  items      EatsCatalogItem[]
  schedule   EatsSchedule?
  orderLoads EatsOrderLoad[]

  @@map("eats_restaurants")
}

model EatsCatalogCategory {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  code         String
  name         Json
  position     Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant EatsRestaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      EatsCatalogItem[]

  @@map("eats_catalog_categories")
}

model EatsCatalogItem {
  id              String   @id @default(uuid())
  restaurantId    String   @map("restaurant_id")
  categoryId      String?  @map("category_id")
  sku             String?  @unique
  name            Json
  description     Json?
  images          Json?
  price           Decimal  @db.Decimal(12, 2)
  currency        String
  active          Boolean  @default(true)
  stock           Int?
  prepTimeMinutes Int      @default(0) @map("prep_time_minutes")
  isDeliveryOnly  Boolean  @default(false) @map("is_delivery_only")
  externalFlags   Json?    @map("external_flags")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  restaurant EatsRestaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   EatsCatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   EatsCatalogItemVariant[]

  @@map("eats_catalog_items")
}

model EatsCatalogItemVariant {
  id         String   @id @default(uuid())
  itemId      String   @map("item_id")
  code       String
  name       Json
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)
  isDefault  Boolean  @default(false) @map("is_default")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  item EatsCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("eats_catalog_item_variants")
}

model EatsCatalogAudit {
  id           String   @id @default(uuid())
  actorMolamId String?  @map("actor_molam_id")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("eats_catalog_audit")
}

model EatsSchedule {
  id                    String   @id @default(uuid())
  restaurantId          String   @unique @map("restaurant_id")
  timezone              String
  leadTimeMinutes       Int      @default(0) @map("lead_time_minutes")
  maxSimultaneousOrders Int      @default(50) @map("max_simultaneous_orders")
  preOrderEnabled       Boolean  @default(true) @map("pre_order_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  restaurant  EatsRestaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  weeklyRules EatsScheduleWeeklyRule[]
  exceptions  EatsScheduleException[]

  @@map("eats_schedules")
}

model EatsScheduleWeeklyRule {
  id         String  @id @default(uuid())
  scheduleId String  @map("schedule_id")
  weekday    Int
  startTime  String  @map("start_time")
  endTime    String  @map("end_time")
  isOpen     Boolean @default(true) @map("is_open")
  position   Int     @default(0)

  schedule EatsSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("eats_schedule_weekly_rules")
}

model EatsScheduleException {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  date       DateTime
  startTime  String?  @map("start_time")
  endTime    String?  @map("end_time")
  isOpen     Boolean  @default(false) @map("is_open")
  note       String?

  schedule EatsSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("eats_schedule_exceptions")
}

model EatsOrderLoad {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  windowStart  DateTime @map("window_start")
  windowEnd    DateTime @map("window_end")
  count        Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant EatsRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, windowStart, windowEnd])
  @@index([restaurantId, windowStart, windowEnd])
  @@map("eats_order_load")
}
