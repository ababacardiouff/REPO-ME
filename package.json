{
  "name": "molam-eats-menu",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "seed": "ts-node prisma/seed.ts",
    "migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "seed:advanced": "ts-node prisma/seed-advanced.ts",
    "seed:schedules": "ts-node scripts/seedSchedules.ts",
    "lint": "eslint src --ext .ts,.js",
    "test:unit": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "ajv": "^8.12.0",
    "aws-sdk": "^2.1350.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "i18next": "^22.4.7",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.1",
    "pg-promise": "^10.10.2",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20"
  }
}
