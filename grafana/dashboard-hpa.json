{
  "title": "Molam Eats HPA Scaling Test",
  "panels": [
    {
      "type": "graph",
      "title": "Latency P95",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_req_duration_bucket[5m])) by (le))" }]
    },
    {
      "type": "graph",
      "title": "Error Rate",
      "targets": [{ "expr": "rate(custom_errors[5m])" }]
    },
    {
      "type": "graph",
      "title": "Pods Active",
      "targets": [{ "expr": "kube_deployment_status_replicas{deployment='eats-plans-service'}" }]
    }
  ]
}
